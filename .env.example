# ==========================================
# Base de Datos Principal (PostgreSQL 17 - Docker)
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=CambiarPorPasswordSeguro_123!
POSTGRES_DB=nettes_db
POSTGRES_PORT=5432

# Cadena de conexión para ASP.NET Core (.NET 8) -> PostgreSQL
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=nettes_db;Username=admin;Password=CambiarPorPasswordSeguro_123!"

# ==========================================
# Base de Datos ERP (Aspel SAE 7.0 - SQL Server Solo Lectura)
# ==========================================
ConnectionStrings__AspelSaeConnection="Server=IP_O_SERVIDOR_SAE;Database=SAE70Empre01;User Id=usuario_lectura;Password=PasswordSoloLectura;TrustServerCertificate=True;ApplicationIntent=ReadOnly;"

# ==========================================
# Autenticación JWT (Backend .NET 8)
# ==========================================
Jwt__Key=ReemplazarConUnaClaveSecretaDeMinimo32Caracteres!
Jwt__Issuer=NettesBackendAPI
Jwt__Audience=NettesNextJsFrontend

