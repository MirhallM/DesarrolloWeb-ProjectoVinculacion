# ==========================================
# Copia este archivo como ".env" (raíz del repo) y cambia los valores.
# El archivo .env NO se sube al repositorio.
#
# IMPORTANTE: ASP.NET Core NO lee este archivo automáticamente.
# Docker Compose lo usa para la sección de PostgreSQL. Para el backend,
# guarda las cadenas de conexión y claves con User Secrets (ver README):
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<valor>"
# ==========================================

# ==========================================
# Base de Datos Principal (PostgreSQL 17 - Docker)
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=CambiarPorPasswordSeguro_123!
POSTGRES_DB=nettes_db
POSTGRES_PORT=5432

# Cadena de conexión para ASP.NET Core (.NET 10) -> PostgreSQL
# La contraseña debe ser la misma que POSTGRES_PASSWORD
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=nettes_db;Username=admin;Password=CambiarPorPasswordSeguro_123!"

# ==========================================
# Base de Datos ERP (Aspel SAE 7.0 - SQL Server, solo lectura)
# La restricción de solo lectura la da la cuenta de SQL Server (permisos),
# no la cadena de conexión.
# ==========================================
ConnectionStrings__AspelSaeConnection="Server=IP_O_SERVIDOR_SAE;Database=SAE70Empre01;User Id=usuario_lectura;Password=PasswordSoloLectura;TrustServerCertificate=True;"

# ==========================================
# Autenticación JWT (Backend .NET 10)
# Solo aplica si en US-13 se decide usar tokens y no cookies.
# ==========================================
Jwt__Key=ReemplazarConUnaClaveSecretaDeMinimo32Caracteres!
Jwt__Issuer=NettesBackendAPI
Jwt__Audience=NettesNextJsFrontend
