# URL interna de la API de .NET 8 (utilizada en el servidor por React Server Components y Route Handlers)
API_URL=http://localhost:5000/api

# URL pública de la API de .NET 8 (utilizada en el navegador por Client Components)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Clave secreta para firmar/validar cookies de sesión BFF (mínimo 32 caracteres)
AUTH_SECRET=ReemplazarConUnaCadenaAleatoriaSegura_Minimo32Caracteres

