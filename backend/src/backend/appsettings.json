{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sync": {
    "MaxBatchSize": 2000,
    "AbandonAfterMinutes": 15,
    "FullRunMaxAgeHours": 24,
    "MaxDeactivationRatio": 0.10,
    "MaxDeactivationCount": 20,
    "UnchangedRunRetentionDays": 30
  }
}
