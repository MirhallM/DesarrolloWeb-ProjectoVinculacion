<Project Sdk="Microsoft.NET.Sdk.Web">
    
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>27f7cecd-3f8c-4284-a5e7-9bbebb4ee3e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reglas del catálogo dentro del ensamblado: las lee el categorizador y también la siembra. -->
    <EmbeddedResource Include="Data\Seed\categories.json" LogicalName="backend.Seed.categories.json" />
    <EmbeddedResource Include="Data\Seed\display-dictionary.json" LogicalName="backend.Seed.display-dictionary.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
	</ItemGroup>
</Project>
